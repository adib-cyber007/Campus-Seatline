# Required PostgreSQL connection string. Require TLS for production databases.
DATABASE_URL=postgresql://seatline_app:change-me@127.0.0.1:5432/campus_seatline

# Use a strong value outside local development.
JWT_SECRET=

# Optional read-only Admin AI assistant configuration.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Configure exactly one Firebase Admin credential source.
# Either provide the complete service-account JSON as one environment value:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or provide an absolute path to a service-account JSON file on the server:
GOOGLE_APPLICATION_CREDENTIALS=
